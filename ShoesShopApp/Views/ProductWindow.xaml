<Window x:Class="ShoesShopApp.Views.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Width="420" Height="700"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Win}">
    <ScrollViewer>
        <StackPanel Margin="20">
            <Image Source="{Binding Photo}" Height="120" HorizontalAlignment="Left"/>
            <Button Content="Выбрать фото" Command="{Binding ChoosePhotoCommand}" HorizontalAlignment="Left"/>

            <StackPanel Visibility="{Binding IsEdit, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="ID"/>
                <TextBox Text="{Binding ProductId, Mode=OneWay}" IsReadOnly="True"/>
            </StackPanel>

            <TextBlock Text="Артикул"/>
            <TextBox Text="{Binding Article}"/>
            <TextBlock Text="Наименование"/>
            <TextBox Text="{Binding ProductName}"/>
            <TextBlock Text="Категория"/>
            <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="CategoryName"
                      SelectedValuePath="CategoryId" SelectedValue="{Binding CategoryId}"/>
            <TextBlock Text="Описание"/>
            <TextBox Text="{Binding Description}" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
            <TextBlock Text="Производитель"/>
            <ComboBox ItemsSource="{Binding Manufacturers}" DisplayMemberPath="ManufacturerName"
                      SelectedValuePath="ManufacturerId" SelectedValue="{Binding ManufacturerId}"/>
            <TextBlock Text="Поставщик"/>
            <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="SupplierName"
                      SelectedValuePath="SupplierId" SelectedValue="{Binding SupplierId}"/>
            <TextBlock Text="Цена"/>
            <TextBox Text="{Binding Price}"/>
            <TextBlock Text="Единица измерения"/>
            <TextBox Text="{Binding Unit}"/>
            <TextBlock Text="Количество на складе"/>
            <TextBox Text="{Binding Quantity}"/>
            <TextBlock Text="Действующая скидка, %"/>
            <TextBox Text="{Binding Discount}"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Сохранить" Command="{Binding SaveCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Content="Удалить" Command="{Binding DeleteCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Visibility="{Binding IsEdit, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Назад" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>