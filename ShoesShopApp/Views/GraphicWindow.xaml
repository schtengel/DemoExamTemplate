<Window x:Class="ShoesShopApp.Views.GraphicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:vm="clr-namespace:ShoesShopApp.ViewModels"
        Title="Заказы" Width="1200" Height="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Win}"
    >
    <DockPanel Margin="15">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Назад" IsCancel="True" Margin="0,0,15,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Период с:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker SelectedDate="{Binding StartDate}" Width="110" Margin="0,0,10,0"/>

                <TextBlock Text="по:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker SelectedDate="{Binding EndDate}" Width="110" Margin="0,0,15,0"/>

                <Button Content="Экспорт в pdf" Command="{Binding ExportPdfCommand}"/>
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{Binding UserName}" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <Border DockPanel.Dock="Top" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,15">
            <UniformGrid Columns="3">
                <StackPanel>
                    <TextBlock Text="Всего заказов за период:" Foreground="Gray"/>
                    <TextBlock Text="{Binding TotalOrdersCount}" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Общая сумма заказов:" Foreground="Gray"/>
                    <TextBlock Text="{Binding TotalOrdersSum, StringFormat='{}{0:N2} ₽'}" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Производителей в топ-5:" Foreground="Gray"/>
                    <TextBlock Text="{Binding Top5ManufacturersCount}" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="Топ-5 моделей обуви в разрезе производителей (количество заказанных пар)"
                   FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>

        <ItemsControl ItemsSource="{Binding TopModels}" VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding ModelName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ManufacturerName}" FontSize="11" Foreground="Gray"/>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Fill="#7FFF00" Height="24" HorizontalAlignment="Left" Width="{Binding ColumnWidth}"/>
                        <TextBlock Grid.Column="2" Text="{Binding TotalPairs, StringFormat='{}{0} пар'}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>