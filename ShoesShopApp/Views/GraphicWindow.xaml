<Window x:Class="ShoesShopApp.Views.GraphicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:vm="clr-namespace:ShoesShopApp.ViewModels"
        Title="Заказы" Width="800" Height="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Win}"
    >
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Content="Назад" IsCancel="True"/>

            <TextBlock Text="Период с:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker SelectedDate="{Binding StartDate}" Margin="0,0,15,0"/>

            <TextBlock Text="по:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker SelectedDate="{Binding EndDate}"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Manufacturers}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0, 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ManufacturerName}"/>
                        <Rectangle Grid.Column="1" Fill="#7FFF00" HorizontalAlignment="Left" Width="{Binding ColumnWidth}"/>
                        <TextBlock Grid.Column="2" Text="{Binding FilteredCount}" HorizontalAlignment="Left" Margin="10, 0"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>