<Window x:Class="ShoesShopApp.Views.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ" Width="420" Height="520"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Win}">
    <StackPanel Margin="20">
        <StackPanel Visibility="{Binding IsEdit, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Номер заказа"/>
            <TextBox Text="{Binding OrderId, Mode=OneWay}" IsReadOnly="True" Height="32"/>
        </StackPanel>

        <TextBlock Text="Артикул заказа (артикул, количество через запятую)"/>
        <TextBox Text="{Binding Articles}" TextWrapping="Wrap" AcceptsReturn="True" Height="50"/>
        <TextBlock Text="Статус заказа"/>
        <ComboBox ItemsSource="{Binding Statuses}" DisplayMemberPath="StatusName"
                  SelectedValuePath="StatusId" SelectedValue="{Binding StatusId}"/>
        <TextBlock Text="Адрес пункта выдачи"/>
        <ComboBox ItemsSource="{Binding Points}" DisplayMemberPath="Address"
                  SelectedValuePath="PickupPointId" SelectedValue="{Binding PickupPointId}"/>
        <TextBlock Text="Дата заказа"/>
        <DatePicker SelectedDate="{Binding OrderDate}"/>
        <TextBlock Text="Дата выдачи"/>
        <DatePicker SelectedDate="{Binding DeliveryDate}"/>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Сохранить" Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Visibility="{Binding IsEdit, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Назад" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>