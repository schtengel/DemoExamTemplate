<Window x:Class="ShoesShopApp.Views.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы" Width="800" Height="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Win}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Content="Назад" IsCancel="True"/>
            <Button Content="Добавить заказ" Command="{Binding AddCommand}"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}" Background="#7FFF00"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Padding="8" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Articles, StringFormat='Артикул заказа: {0}'}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Status.StatusName, StringFormat='Статус заказа: {0}'}"/>
                                <TextBlock Text="{Binding PickupPoint.Address, StringFormat='Адрес пункта выдачи: {0}'}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding OrderDate, StringFormat='Дата заказа: {0:dd.MM.yyyy}'}"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Padding="4">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Дата доставки" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding DeliveryDate, StringFormat=dd.MM.yyyy}" FontSize="18" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>